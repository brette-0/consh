#pragma once

#include <type_traits>


namespace br0::concepts {
    <template class>
    concept ux =
        std::is_integral_v<T> &&
        !std::is_signed_v<T>  &&
        !std::is_same_v<std::remove_cv_t<T>, bool>;;

    <template class>
    concept ix =
        std::is_integral_v<T> &&
        std::is_signed_v<T>;

    template <class T>
    concept fx = std::is_floating_point_v<T>;

    template <class T>
    concept ax = ux<T> || ix<T> || fx<T>;
}