#pragma once

#include <type_traits>


namespace br0::consh {
    template <class T>
    concept ux =
        std::is_integral_v<T> &&
        !std::is_signed_v<T>  &&
        !std::is_same_v<std::remove_cv_t<T>, bool>;

    template <class T>
    concept ix =
        std::is_integral_v<T> &&
        std::is_signed_v<T>;

    template <class T>
    concept fx = std::is_floating_point_v<T>;

    template <class T>
    concept ax = ux<T> || ix<T> || fx<T>;

    template <class T>
    concept nx =
        (ix<T> || ux<T>) &&
        !fx<T>;
}